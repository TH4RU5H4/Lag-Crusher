{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Lag Crusher",
  "version": "1.1.3",
  "identifier": "com.lagcrusher.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lag Crusher",
        "width": 420,
        "height": 740
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.dialog.lk https://*.mobitel.lk https://*.hutch.lk https://*.airtel.lk; connect-src 'self' https://*.dialog.lk https://*.mobitel.lk https://*.hutch.lk https://*.airtel.lk"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  },
  "android": {
    "minSdk": 24,
    "targetSdk": 34,
    "permissions": [
      "INTERNET",
      "FOREGROUND_SERVICE",
      "FOREGROUND_SERVICE_DATA_SYNC",
      "WAKE_LOCK",
      "POST_NOTIFICATIONS",
      "RECEIVE_BOOT_COMPLETED"
    ]
  },
  "plugins": {
    "crusher-android": {}
  }
}
